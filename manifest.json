{
  "manifest_version": 3,
  "name": "YouTube Auto Skip",
  "version": "4.0.0",
  "description": "YouTube ad control with selectable modes.",
  "permissions": [
    "debugger",
    "storage"
  ],
  "action": {
    "default_title": "YouTube Auto Skip",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
